# Copia este archivo como .env (en esta misma carpeta api/) y llena tus datos.

# Puerto de la API
PUERTO=3000

# MySQL (la base de datos se crea sola la primera vez que arranca la API)
BD_HOST=localhost
BD_USUARIO=root
BD_CONTRASENIA=root
BD_NOMBRE=mySpa

# Cualquier texto largo y secreto para firmar las sesiones
JWT_SECRETO=cambia_esto_por_un_texto_largo

# Correo (opcional). Si lo dejas vacío, la API funciona igual pero no envía correos. cambios
CORREO_HOST=smtp.gmail.com
CORREO_PUERTO=465
CORREO_USUARIO=
CORREO_CONTRASENIA=
